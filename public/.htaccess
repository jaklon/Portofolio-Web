# jascon.my.id - place in this domain's document root only.
# Activate the domain's SSL certificate before uploading this file.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical address. Conditions keep redirects specific to this domain.
  RewriteCond %{HTTP_HOST} ^www\.jascon\.my\.id(?::[0-9]+)?$ [NC]
  RewriteRule ^ https://jascon.my.id%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^jascon\.my\.id(?::[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://jascon.my.id%{REQUEST_URI} [R=301,L,NE]

  # The catalogue route shares its name with the real projects/media folder.
  # Handle it before Apache treats that folder as a directory request.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?jascon\.my\.id(?::[0-9]+)?$ [NC]
  RewriteRule ^projects/?$ index.html [L]

  # Serve real files and folders without rewriting their contents.
  # Let JV Story handle its own pages, API, and authenticated media routes.
  RewriteRule ^jv-story(?:/|$) - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing static files should return 404, rather than the app's HTML.
  RewriteRule ^(?:assets|models|wallpapers|logos|covers)(?:/|$) - [L,NC]
  RewriteRule \.(?:html?|css|js|mjs|map|json|wasm|glb|gltf|svg|png|jpe?g|gif|webp|avif|ico|woff2?|ttf|otf|txt|xml|pdf)$ - [L,NC]

  # /projects is also a real media directory. Its case-study routes still
  # reach React because only existing files/directories were excluded above.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?jascon\.my\.id(?::[0-9]+)?$ [NC]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  # Keep the entry document fresh when a new version is uploaded.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Non-versioned media can be replaced at the same URL.
  <FilesMatch "\.(?:css|js|mjs|svg|png|jpe?g|gif|webp|avif|ico|glb|gltf|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Vite changes the filename when these assets change.
  <FilesMatch "^.+-[A-Za-z0-9_-]{8,}\.(?:js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
